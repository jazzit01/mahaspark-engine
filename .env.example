# Copy this file to .env and fill in your real values locally.
# Do not commit .env to Git.

# Required
GEMINI_API_KEY=your_gemini_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# TELEGRAM_CHAT_ID defaults to the project's existing chat; set it only to send somewhere else.
# TELEGRAM_CHAT_ID=your_telegram_chat_id_here
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Last-resort script writers (optional; each is used only if set, after Gemini)
GROQ_API_KEY=your_groq_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional overrides
# GEMINI_MODELS=gemini-2.5-pro,gemini-2.5-flash
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts   (one name or a comma list; fallbacks are tried automatically)
# GEMINI_TTS_VOICE=Kore
# RSS_FEEDS=https://example.com/feed1.xml,https://example.com/feed2.xml
# MAX_STORIES_PER_RUN=1
# REMOTION_CONCURRENCY=2   (capped at the machine's CPU cores; default is all cores)
